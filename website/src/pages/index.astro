---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Comparison from '../components/Comparison.astro';
import DownloadMatrix from '../components/DownloadMatrix.astro';
import QuickStart from '../components/QuickStart.astro';
import Footer from '../components/Footer.astro';
import { LATEST_VERSION_NUM } from '../config/version';

const lang = 'en';
const siteTitle = "OmniTerminal - Cross-Platform SSH & SFTP Client for macOS, Windows & Linux";
const siteDescription = "A cross-platform SSH and SFTP desktop client for cluster operations and systems engineering. Powered by Go concurrency, WebGL GPU acceleration, and local AES-256-GCM credential encryption.";
const siteUrl = "https://omniterminal.leonlwq.com/";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <meta name="keywords" content="OmniTerminal, SSH client, SFTP client, Xshell alternative, SecureCRT alternative, Mac SSH client, Cross-platform terminal, Free open source SSH tool, WebGL GPU terminal" />
    <link rel="canonical" href="https://omniterminal.leonlwq.com/" />
    
    <!-- Language Alternates for SEO -->
    <link rel="alternate" hreflang="en" href="https://omniterminal.leonlwq.com/" />
    <link rel="alternate" hreflang="zh" href="https://omniterminal.leonlwq.com/zh/" />
    <link rel="alternate" hreflang="ja" href="https://omniterminal.leonlwq.com/ja/" />
    <link rel="alternate" hreflang="ko" href="https://omniterminal.leonlwq.com/ko/" />
    <link rel="alternate" hreflang="x-default" href="https://omniterminal.leonlwq.com/" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:image" content="/appicon.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={siteDescription} />
    <meta property="twitter:image" content="/appicon.png" />

    <!-- Schema.org JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "OmniTerminal",
        "operatingSystem": "macOS, Windows, Linux",
        "applicationCategory": "DeveloperApplication",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "A cross-platform SSH and SFTP desktop client for cluster operations and systems engineering. Powered by Go concurrency, WebGL GPU acceleration, and local AES-256-GCM credential encryption.",
        "url": "https://omniterminal.leonlwq.com/",
        "softwareVersion": LATEST_VERSION_NUM,
        "license": "https://opensource.org/licenses/MIT"
      }
    </script>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body class="bg-[#0a0c10] text-slate-100 antialiased selection:bg-blue-600 selection:text-white">
    <Navbar lang={lang} />
    <main>
      <Hero lang={lang} />
      <Features lang={lang} />
      <Comparison lang={lang} />
      <DownloadMatrix lang={lang} />
      <QuickStart lang={lang} />
    </main>
    <Footer lang={lang} />
  </body>
</html>
