---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
const isEn = lang === 'en';

const steps = [
  {
    step: "01",
    title: t('qs.s1.title'),
    desc: t('qs.s1.desc'),
  },
  {
    step: "02",
    title: t('qs.s2.title'),
    desc: t('qs.s2.desc'),
  },
  {
    step: "03",
    title: t('qs.s3.title'),
    desc: t('qs.s3.desc'),
  },
];

const shortcuts = [
  { 
    key: "Cmd/Ctrl + C", 
    action: isEn ? "Copy selected text, or pass SIGINT interrupt signal if no selection" : "有选区时复制文本，无选区时透传 SIGINT 中断信号" 
  },
  { 
    key: "Cmd/Ctrl + Shift + F", 
    action: isEn ? "Summon Live Buffer Filter pane with regex log streaming" : "呼出实时日志过滤器 (Live Buffer Filter)，正则抓取关键句" 
  },
  { 
    key: "Ctrl + Enter", 
    action: isEn ? "Broadcast multi-line command to all terminals via Compose Pane" : "在底部 Compose 多行撰写面板中一键向所有终端广播指令" 
  },
  { 
    key: "Cmd/Ctrl + F", 
    action: isEn ? "Fast in-terminal regex search and match highlights" : "终端内快速全文检索并正则高亮匹配" 
  },
  { 
    key: "F11", 
    action: isEn ? "Toggle borderless immersive geek fullscreen workspace" : "一键切换无边框极客全屏沉浸式工作模式" 
  },
  { 
    key: isEn ? "Double click Tab bar" : "双击 Tab 栏空白", 
    action: isEn ? "Quickly open a new session or launch local Shell" : "极速新建会话或打开本地 Shell 终端" 
  },
];
---

<section id="quickstart" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto scroll-mt-20">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="text-xs font-semibold uppercase tracking-wider text-blue-400 mb-3">
      {t('qs.tag')}
    </div>
    <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
      {t('qs.title')}
    </h2>
    <p class="text-slate-400 text-base sm:text-lg">
      {t('qs.desc')}
    </p>
  </div>

  <!-- 3 Steps -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
    {steps.map((s) => (
      <div class="glass-card rounded-2xl p-6 relative">
        <span class="text-3xl font-black text-blue-500/20 font-mono absolute top-6 right-6">
          {s.step}
        </span>
        <h3 class="text-lg font-bold text-white mb-2">{s.title}</h3>
        <p class="text-sm text-slate-400 leading-relaxed">{s.desc}</p>
      </div>
    ))}
  </div>

  <!-- Shortcuts Cheat Sheet -->
  <div class="glass-panel rounded-2xl p-6 sm:p-8 border border-white/10">
    <div class="flex items-center justify-between mb-6">
      <h3 class="text-lg font-bold text-white flex items-center gap-2">
        <span>⚡</span> {t('qs.shortcuts.title')}
      </h3>
      <span class="text-xs text-slate-400 font-mono">{t('qs.shortcuts.sub')}</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {shortcuts.map((sc) => (
        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-900/60 border border-white/5">
          <span class="text-xs text-slate-300 font-medium">{sc.action}</span>
          <kbd class="px-2.5 py-1 text-xs font-mono text-blue-300 bg-slate-800 rounded border border-slate-700 shadow shrink-0 ml-3">
            {sc.key}
          </kbd>
        </div>
      ))}
    </div>
  </div>
</section>
