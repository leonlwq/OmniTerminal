---
import DownloadButton from './DownloadButton';
import InteractiveTerminal from './InteractiveTerminal';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section class="relative pt-32 pb-20 px-4 sm:px-6 lg:px-8 overflow-hidden">
  <!-- Glowing background effects -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-blue-600/15 blur-[120px] rounded-full pointer-events-none -z-10" />
  <div class="absolute top-1/3 left-1/4 w-[400px] h-[250px] bg-indigo-600/10 blur-[100px] rounded-full pointer-events-none -z-10" />

  <div class="max-w-6xl mx-auto text-center">
    <!-- Announcement capsule badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-slate-700/60 shadow-inner mb-8 hover:border-blue-500/50 transition-colors">
      <span class="flex h-2 w-2 rounded-full bg-blue-400 animate-ping" />
      <span class="text-xs font-medium text-slate-300">
        {t('hero.badge')}
      </span>
      <a href="https://github.com/leonlwq/OmniTerminal/releases" target="_blank" rel="noreferrer" class="text-xs text-blue-400 hover:text-blue-300 font-semibold flex items-center gap-0.5">
        {t('hero.changelog')}
      </a>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white mb-6 leading-[1.1]">
      {t('hero.title.1')} <span class="text-gradient-blue">{t('hero.title.highlight1')}</span> {t('hero.title.and')} <br class="hidden sm:block" />
      <span class="text-gradient-cyan">{t('hero.title.highlight2')}</span>
    </h1>

    <!-- Subtitle description -->
    <p class="max-w-3xl mx-auto text-base sm:text-lg text-slate-300 leading-relaxed mb-10 whitespace-pre-line">
      {t('hero.subtitle')}
    </p>

    <!-- Download Call to Action -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <DownloadButton client:load lang={lang} />

      <a
        href="https://github.com/leonlwq/OmniTerminal"
        target="_blank"
        rel="noreferrer"
        class="flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-900/80 hover:bg-slate-800 text-slate-200 border border-slate-700/80 font-medium text-base shadow-sm hover:border-slate-600 transition-all"
      >
        <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>{t('hero.github')}</span>
      </a>
    </div>

    <!-- Feature Pill Badges -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 max-w-4xl mx-auto mb-16 text-xs text-slate-300">
      <div class="glass-panel py-2.5 px-4 rounded-xl flex items-center justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        <span>{t('hero.pill.concurrency')}</span>
      </div>
      <div class="glass-panel py-2.5 px-4 rounded-xl flex items-center justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-blue-400"></span>
        <span>{t('hero.pill.gpu')}</span>
      </div>
      <div class="glass-panel py-2.5 px-4 rounded-xl flex items-center justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
        <span>{t('hero.pill.security')}</span>
      </div>
      <div class="glass-panel py-2.5 px-4 rounded-xl flex items-center justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-cyan-400"></span>
        <span>{t('hero.pill.crossplatform')}</span>
      </div>
    </div>

    <!-- Interactive Terminal Canvas Mockup -->
    <div id="demo" class="scroll-mt-24">
      <InteractiveTerminal client:visible lang={lang} />
    </div>
  </div>
</section>
