---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
const REPO = "leonlwq/OmniTerminal";

// Switch language link target
const targetLangUrl = lang === 'zh' ? '/en/' : '/';
const switchLangLabel = lang === 'zh' ? 'English' : '简体中文';
const homeUrl = lang === 'zh' ? '/' : '/en/';
---

<header class="fixed top-0 left-0 right-0 z-50 glass-panel border-b border-white/5 bg-slate-950/80 backdrop-blur-xl">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={homeUrl} class="flex items-center gap-3 group">
      <img src="/appicon.png" alt="OmniTerminal Logo" class="w-9 h-9 rounded-xl shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform" />
      <div class="flex flex-col">
        <span class="font-bold text-base tracking-wide text-white flex items-center gap-2">
          OmniTerminal
          <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20">
            v1.0.0
          </span>
        </span>
        <span class="text-[10px] text-slate-400 -mt-0.5">{t('nav.subtitle')}</span>
      </div>
    </a>

    <!-- Navigation Links -->
    <nav class="hidden md:flex items-center gap-8 text-sm text-slate-300">
      <a href="#features" class="hover:text-blue-400 transition-colors">{t('nav.features')}</a>
      <a href="#demo" class="hover:text-blue-400 transition-colors">{t('nav.demo')}</a>
      <a href="#comparison" class="hover:text-blue-400 transition-colors">{t('nav.comparison')}</a>
      <a href="#download" class="hover:text-blue-400 transition-colors">{t('nav.download')}</a>
      <a href="#quickstart" class="hover:text-blue-400 transition-colors">{t('nav.quickstart')}</a>
    </nav>

    <!-- Right Actions: Language Switcher, GitHub & Download CTA -->
    <div class="flex items-center gap-2.5 sm:gap-3">
      <!-- Language Switcher Pill -->
      <a
        href={targetLangUrl}
        aria-label="Switch Language"
        class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium rounded-xl bg-slate-900/90 hover:bg-slate-800 text-slate-300 hover:text-white border border-slate-700/80 hover:border-blue-500/50 transition-all shadow-sm"
      >
        <span class="text-sm">🌐</span>
        <span class="hidden sm:inline font-mono">{switchLangLabel}</span>
        <span class="sm:hidden font-mono uppercase font-semibold">{lang === 'zh' ? 'EN' : '中'}</span>
      </a>

      <!-- GitHub Stars -->
      <a
        href={`https://github.com/${REPO}`}
        target="_blank"
        rel="noreferrer"
        class="hidden sm:flex items-center gap-2 px-3.5 py-2 text-xs font-medium rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-700/80 hover:border-slate-600 transition-all shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>Star</span>
      </a>

      <!-- Quick Download CTA -->
      <a
        href="#download"
        class="px-3.5 sm:px-4 py-2 text-xs font-semibold rounded-xl bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-500/25 transition-all"
      >
        {t('nav.get')}
      </a>
    </div>
  </div>
</header>
