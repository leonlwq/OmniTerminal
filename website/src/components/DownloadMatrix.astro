---
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'zh' } = Astro.props;
const t = useTranslations(lang);
const isEn = lang === 'en';

const REPO = "leonlwq/OmniTerminal";
const VERSION = "v1.0.0";
const BASE_DOWNLOAD = `https://github.com/${REPO}/releases/download/${VERSION}`;

const downloads = [
  {
    platform: "macOS",
    arch: isEn ? "Apple Silicon (M1/M2/M3/M4)" : "Apple Silicon (M1/M2/M3/M4)",
    format: isEn ? "DMG Disk Image" : "DMG 拖拽安装镜像",
    file: "OmniTerminal-macos-arm64.dmg",
    url: `${BASE_DOWNLOAD}/OmniTerminal-macos-arm64.dmg`,
    tag: isEn ? "Recommended (Mac)" : "推荐 (Mac 用户)",
  },
  {
    platform: "macOS",
    arch: isEn ? "Apple Silicon (Portable)" : "Apple Silicon 免解压版",
    format: isEn ? "ZIP Archive" : "ZIP 压缩包",
    file: "OmniTerminal-macos-arm64.zip",
    url: `${BASE_DOWNLOAD}/OmniTerminal-macos-arm64.zip`,
    tag: isEn ? "Portable" : "绿色版",
  },
  {
    platform: "macOS",
    arch: isEn ? "Intel 64-bit CPU" : "Intel 64-bit 芯片",
    format: isEn ? "DMG Disk Image" : "DMG 拖拽安装镜像",
    file: "OmniTerminal-macos-intel.dmg",
    url: `${BASE_DOWNLOAD}/OmniTerminal-macos-intel.dmg`,
    tag: "Intel Mac",
  },
  {
    platform: "Windows",
    arch: isEn ? "x64 (64-bit Intel / AMD)" : "x64 (64位 Intel / AMD)",
    format: isEn ? "ZIP Portable" : "ZIP 绿色免安装包",
    file: "OmniTerminal-windows-amd64.zip",
    url: `${BASE_DOWNLOAD}/OmniTerminal-windows-amd64.zip`,
    tag: isEn ? "Recommended (Win)" : "推荐 (Win 用户)",
  },
  {
    platform: "Windows",
    arch: isEn ? "ARM64 (Surface / Snapdragon X)" : "ARM64 (Surface / 骁龙X)",
    format: isEn ? "ZIP Portable" : "ZIP 绿色免安装包",
    file: "OmniTerminal-windows-arm64.zip",
    url: `${BASE_DOWNLOAD}/OmniTerminal-windows-arm64.zip`,
    tag: "Win ARM64",
  },
  {
    platform: "Linux",
    arch: isEn ? "x86_64 (glibc 2.35+)" : "x86_64 (glibc 2.35+)",
    format: isEn ? "tar.gz Universal Archive" : "tar.gz 标准包",
    file: "OmniTerminal-linux-amd64.tar.gz",
    url: `${BASE_DOWNLOAD}/OmniTerminal-linux-amd64.tar.gz`,
    tag: "Ubuntu / Debian / CentOS",
  },
];
---

<section id="download" class="py-24 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto scroll-mt-20">
  <div class="text-center max-w-3xl mx-auto mb-16">
    <div class="text-xs font-semibold uppercase tracking-wider text-blue-400 mb-3">
      {t('dl.tag')}
    </div>
    <h2 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight mb-4">
      {t('dl.title')}
    </h2>
    <p class="text-slate-400 text-base sm:text-lg">
      {t('dl.desc')}
    </p>
  </div>

  <div class="glass-panel rounded-2xl overflow-hidden border border-white/10 shadow-2xl">
    <div class="p-6 bg-slate-900/90 border-b border-white/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          {t('dl.header.title')}
          <span class="text-xs font-mono font-normal px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
            {t('dl.header.stable')}
          </span>
        </h3>
        <p class="text-xs text-slate-400 mt-1">
          {t('dl.header.info')}
        </p>
      </div>

      <a
        href={`https://github.com/${REPO}/releases/tag/${VERSION}`}
        target="_blank"
        rel="noreferrer"
        class="text-xs font-medium text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1 font-mono"
      >
        {t('dl.header.checksum')}
      </a>
    </div>

    <div class="divide-y divide-white/5 font-sans">
      {downloads.map((item) => (
        <div class="p-4 sm:p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-800/40 transition-colors">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 rounded-xl bg-slate-800 border border-slate-700/80 flex items-center justify-center shrink-0">
              <span class="font-bold text-slate-300 text-xs">{item.platform.slice(0, 3)}</span>
            </div>
            <div>
              <div class="text-sm font-semibold text-white flex items-center gap-2">
                <span>{item.platform}</span>
                <span class="text-xs font-normal text-slate-400">({item.arch})</span>
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-300 border border-blue-500/20">
                  {item.tag}
                </span>
              </div>
              <div class="text-xs text-slate-400 font-mono mt-0.5">
                {item.file} ({item.format})
              </div>
            </div>
          </div>

          <div class="flex items-center gap-3 self-end sm:self-center">
            <a
              href={item.url}
              class="px-4 py-2 text-xs font-semibold rounded-xl bg-blue-600 hover:bg-blue-500 text-white shadow-md shadow-blue-500/20 transition-all flex items-center gap-1.5"
            >
              <svg class="w-3.5 h-3.5 fill-none stroke-current stroke-2" viewBox="0 0 24 24">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
              </svg>
              <span>{t('dl.btn')}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
